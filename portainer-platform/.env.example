# Portainer Configuration
APP_DOMAIN=your-domain.com
PORTAINER_PORT=9000
PORTAINER_EDGE_PORT=9443
PORTAINER_EDGE_INSECURE_POLL=false

# Shared Docker network (must match nginx-platform NETWORK_NAME).
NETWORK_NAME=devops

# Data volume mode: dir (host bind) | nfs (docker-managed NFS).
# All vars below must be set — both _nfs and _dir volumes are declared,
# *_TYPE only switches which one the service mounts.
PORTAINER_VOLUME_TYPE=dir
PORTAINER_VOLUME_IP=192.168.1.10
PORTAINER_VOLUME_PATH=/var/lib/portainer/data

# Must match nginx-platform CERTBOT_CONF_VOLUME_PATH (dir mode,
# shared host path — the TLS certs for portainer.${APP_DOMAIN} live there).
CERTBOT_BASE_DIR=/var/lib/nginx-platform/certbot-conf

# Full portainer command (single string). Default = TLS with LE certs above.
# Plain HTTP:              PORTAINER_COMMAND=-H unix:///var/run/docker.sock
# Custom cert dir layout:  PORTAINER_COMMAND=-H unix:///var/run/docker.sock --tlscert /certs/example.com/cert.pem --tlskey /certs/example.com/key.pem
