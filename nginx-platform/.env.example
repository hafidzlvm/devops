APP_DOMAIN=your-domain.com
SSL_EMAIL=your@gmail.com

# Shared Docker network (must exist: docker network create "$NETWORK_NAME").
NETWORK_NAME=devops

# Certbot volume mode: dir (host bind) | nfs (docker-managed NFS).
# All vars below must be set — both _nfs and _dir volumes are declared,
# *_TYPE only switches which one the services mount.
CERTBOT_VOLUME_TYPE=dir
CERTBOT_VOLUME_IP=192.168.1.10
CERTBOT_CONF_VOLUME_PATH=/var/lib/nginx-platform/certbot-conf
CERTBOT_WWW_VOLUME_PATH=/var/lib/nginx-platform/certbot-www

# CORS auto-generation (nginx/90-generate-cors.sh builds the
# $CORS_ALL_ALLOWED_DOMAIN map at container start — no manual map edits).
# Base domains: apex + ALL subdomains allowed automatically.
CORS_BASE_DOMAINS="your-domain.com"
# One-off origins outside base domains (space-separated, quoted).
CORS_EXTRA_ORIGINS="https://frontend-kamu.com"
# CORS map volume mode: dir (host bind) | nfs (docker-managed NFS).
# The map file lives here — hand-editable mid-run + `nginx -s reload`.
CORS_VOLUME_TYPE=dir
CORS_VOLUME_IP=192.168.1.10
CORS_VOLUME_PATH=/var/lib/nginx-platform/cors
